<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Caisarra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#071017</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#090F11</item>
        <item name="android:windowSplashScreenBackground">#090F11</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent_icon</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/transparent_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Caisarra</item>
    </style>
    <style name="UCropTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#080D13</item>
        <item name="colorPrimaryDark">#080D13</item>
        <item name="colorAccent">#08D5E5</item>
        <item name="android:statusBarColor">#080D13</item>
        <item name="android:navigationBarColor">#080D13</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
